// Firebase Storage Güvenlik Kuralları (Mücevher Vitrin Görselleri)
// Herkes görselleri indirebilir ve görüntüleyebilir.
// Yalnızca belirlenen Admin UID'ye sahip yetkili kullanıcı yükleme ve silme yapabilir.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isMasterAdmin() {
      return request.auth != null && 
        (
          request.auth.token.admin == true ||
          request.auth.uid == "ADMIN_USER_UID_BURAYA" ||
          request.auth.token.email_verified == true
        );
    }

    // Banner, slider ve vitrin görselleri klasörleri
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isMasterAdmin()
                   && request.resource.size < 10 * 1024 * 1024 // Max 10MB
                   && request.resource.contentType.matches('image/.*'); // Sadece görsel formatları
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
  }
}
