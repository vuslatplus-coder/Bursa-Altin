<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Eğer istenen dosya veya dizin gerçekten varsa doğrudan sun
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /admin dahil tüm SPA yollarını index.html dosyasına yönlendir (404 hatasını önler)
  RewriteRule ^ index.html [L]
</IfModule>
