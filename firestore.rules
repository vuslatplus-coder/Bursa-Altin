rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dynamic Navigation & Mega Menus
    match /menu_gruplari/{groupId} {
      allow read, write: if true;
    }
    match /navigationGroups/{groupId} {
      allow read, write: if true;
    }
    match /navigation_groups/{groupId} {
      allow read, write: if true;
    }

    // Site Visual Content & Banners
    match /site_content/{documentId} {
      allow read, write: if true;
    }
    match /site_visual_content/{documentId} {
      allow read, write: if true;
    }

    // Altın Rehberi (Gold Guide)
    match /guideArticles/{articleId} {
      allow read, write: if true;
    }
    match /guide_articles/{articleId} {
      allow read, write: if true;
    }

    // Corporate Pages & Dedicated Services
    match /contentPages/{pageId} {
      allow read, write: if true;
    }
    match /content_pages/{pageId} {
      allow read, write: if true;
    }
    match /page_altinini_getir/{documentId} {
      allow read, write: if true;
    }

    // Footer Links
    match /footerLinks/{linkId} {
      allow read, write: if true;
    }
    match /footer_links/{linkId} {
      allow read, write: if true;
    }

    // Global Settings (TopBar, AltininiGetir, etc.)
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }
    match /top_bar_config/{settingId} {
      allow read, write: if true;
    }

    // Appointments & VIP bookings (Visitors can create, Admin can read/manage)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Waitlist & Notifications
    match /waitlist/{waitlistId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

